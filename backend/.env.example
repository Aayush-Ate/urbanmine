# Copy to .env and fill what you need. .env is gitignored.
# Leave DATABASE_URL empty to use the local data.json file.
DATABASE_URL=

# Where uploaded photos go. Default is backend/uploads.
# On Render, Fly.io, or another host with ephemeral disk, set /tmp/uploads.
UPLOAD_DIR=

# Optional model paths. Defaults are yolov8n.pt and yolov8m-worldv2.pt.
YOLO_MODEL_PATH=
WORLD_MODEL_PATH=
