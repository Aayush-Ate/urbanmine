{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://backend-one-chi-21.vercel.app/api/$1"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "https://backend-one-chi-21.vercel.app/uploads/$1"
    }
  ]
}
