# Optional — unlocks Cesium ion imagery, world terrain and 3D tiles.
# Get one free at https://ion.cesium.com/tokens
# Without it the globe runs keyless on Esri satellite imagery.
VITE_CESIUM_TOKEN=

# Optional — Google Maps Platform Photorealistic 3D Tiles (Google-Earth look).
# ion dashboard → Asset Depot → add it, then paste its asset ID here.
# Needs VITE_CESIUM_TOKEN too. Without it, the satellite globe stays.
VITE_GOOGLE_TILES_ASSET_ID=

# Optional — HERE Geocoding & Search (free tier at developer.here.com).
# With it, address search + reverse lookup use HERE (India-biased, faster).
# Without it, the app falls back to Nominatim (OSM, keyless, rate-limited).
VITE_HERE_API_KEY=
